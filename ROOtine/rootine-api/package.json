{
  "name": "rootine-api",
  "version": "1.0.0",
  "description": "Backend NestJS + MikroORM + InversifyJS do Rootine (refatoração das Edge Functions Deno).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "mikro-orm": "mikro-orm",
    "schema:diff": "mikro-orm schema:update --dump",
    "test": "node --test"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.14",
    "@mikro-orm/migrations": "^6.6.14",
    "@mikro-orm/nestjs": "^6.1.2",
    "@mikro-orm/postgresql": "^6.6.14",
    "@mikro-orm/reflection": "^6.6.14",
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@supabase/supabase-js": "^2.108.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "inversify": "^6.2.2",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.14",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
}
